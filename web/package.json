{
  "name": "matan-geometry",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "sync": "bun scripts/sync_links.ts && python3 scripts/sync_notes.py",
    "build": "bun run sync && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "bun test",
    "test:browser": "playwright test",
    "capture": "bun scripts/capture.ts",
    "format": "prettier --write src scripts tests *.ts *.json *.html *.md",
    "format:check": "prettier --check src scripts tests *.ts *.json *.html *.md"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "katex": "0.18.6",
    "mafs": "0.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "3.8.3",
    "typescript": "~5.9.3",
    "vite": "8.2.2"
  },
  "packageManager": "bun@1.4.0"
}
